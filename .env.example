APP_NAME="Steizen Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://topup.example.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
DB_CONNECTION=sqlite
# MySQL produksi: database BARU dan user khusus, bukan root.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=steizen_laravel
# DB_USERNAME=steizen_app
# DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
STORE_MODE=demo
CATALOG_SOURCE=demo
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
SELLING_MARGIN_PERCENT=10

# STORE_MODE=sandbox untuk pengujian gateway, tetap tanpa pembayaran produksi.
# Jangan isi kredensial riil di file contoh ini atau repository.
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
# Callback publik HTTPS, misalnya https://domain-uji.example/api/payments/tripay/callback
TRIPAY_CALLBACK_URL=
